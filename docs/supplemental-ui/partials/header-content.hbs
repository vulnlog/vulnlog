{{#if env.SITE_SEARCH_PROVIDER}}
<script>
  // Press "/" anywhere outside a text field to jump to the search box.
  document.addEventListener('keydown', function (e) {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return
    var target = e.target
    if (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return
    var input = document.getElementById('search-input')
    if (!input) return
    e.preventDefault()
    input.focus()
    input.select()
  })
</script>
{{/if}}
<script>
  // Repository facts (latest release, stars, forks) from the public GitHub API, cached for an hour.
  // Unauthenticated requests are limited to 60 per hour per IP. If a request fails, only the name shows.
  (function () {
    var KEY = 'vulnlog-github-facts'
    var TTL = 60 * 60 * 1000
    var box = document.querySelector('.vl-source-facts')
    if (!box) return
    function compact (n) {
      return n >= 1000 ? (Math.round(n / 100) / 10).toString().replace(/\.0$/, '') + 'k' : String(n)
    }
    function show (facts) {
      var shown = false
      ;['version', 'stars', 'forks'].forEach(function (name) {
        var el = box.querySelector('[data-fact="' + name + '"]')
        var value = facts[name]
        if (value == null) return
        el.querySelector('.vl-fact-value').textContent = typeof value === 'number' ? compact(value) : value
        el.classList.add('is-loaded')
        shown = true
      })
      if (shown) box.classList.add('is-loaded')
    }
    try {
      var cached = JSON.parse(localStorage.getItem(KEY))
      if (cached && Date.now() - cached.time < TTL) return show(cached)
    } catch (e) {}
    function get (url) {
      return fetch(url, { headers: { Accept: 'application/vnd.github+json' } })
        .then(function (res) { return res.ok ? res.json() : null })
        .catch(function () { return null })
    }
    Promise.all([
      get('https://api.github.com/repos/vulnlog/vulnlog'),
      get('https://api.github.com/repos/vulnlog/vulnlog/releases/latest'),
    ]).then(function (results) {
      var repo = results[0]
      var release = results[1]
      var facts = {
        time: Date.now(),
        version: release && release.tag_name,
        stars: repo && repo.stargazers_count,
        forks: repo && repo.forks_count,
      }
      if (!repo && !release) return
      try { localStorage.setItem(KEY, JSON.stringify(facts)) } catch (e) {}
      show(facts)
    })
  })()
</script>
<script>
  // Theme toggle: system, light, dark. The choice is stored in localStorage. "System" removes it,
  // so the CSS follows prefers-color-scheme again.
  (function () {
    var KEY = 'vulnlog-theme'
    var ORDER = ['system', 'light', 'dark']
    var button = document.querySelector('.vl-theme-toggle')
    if (!button) return
    var label = button.querySelector('.vl-theme-toggle-label')
    function apply (mode) {
      var root = document.documentElement
      if (mode === 'system') delete root.dataset.theme
      else root.dataset.theme = mode
      var next = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length]
      button.dataset.mode = mode
      button.title = 'Theme: ' + mode + '. Switch to ' + next + '.'
      button.setAttribute('aria-label', button.title)
      label.textContent = 'Theme: ' + mode
    }
    var stored = document.documentElement.dataset.theme
    apply(stored === 'light' || stored === 'dark' ? stored : 'system')
    button.addEventListener('click', function () {
      var mode = ORDER[(ORDER.indexOf(button.dataset.mode) + 1) % ORDER.length]
      try {
        if (mode === 'system') localStorage.removeItem(KEY)
        else localStorage.setItem(KEY, mode)
      } catch (e) {}
      apply(mode)
    })
  })()
</script>
